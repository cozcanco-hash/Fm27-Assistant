{
  "name": "fm27-assistant-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "tauri": "tauri",
    "icons": "tauri icon src/assets/fm27-icon.png --output src-tauri/icons",
    "desktop:dev": "npm run icons && tauri dev",
    "desktop:build": "npm run icons && tauri build",
    "test": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "@playwright/test": "1.56.1"
  }
}
